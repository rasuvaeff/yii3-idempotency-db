{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    // 2 named equivalent survivors (Covered Code MSI 98%, well above the 85
    // floor below — no ignores, no lowering):
    // - DbIdempotencyStorage.php:100 `$affected > 0` -> `>= 0` (GreaterThan).
    //   insert() against a real DB backend either affects exactly 1 row or
    //   throws IntegrityException on the unique-key conflict (caught right
    //   below, returns false); `$affected === 0` without an exception is not
    //   reachable through the public contract. Forcing it would need a fake
    //   Connection double as a src-level test seam — out of scope here.
    // - RecordRowMapper.php:188 `throw new InvalidRecordRowException(...)`
    //   removed (Throw_), in extractInt()'s isset guard. Falling through
    //   lands on the function's final fallback throw at line 201, which
    //   raises the exact same class with the byte-identical message —
    //   `sprintf('Missing or invalid column "%s" in idempotency record row',
    //   $column)` at both sites, confirmed by tightening the "missing
    //   status_code" case to an exact-message assertion and re-running: the
    //   mutant still survives because there is nothing left to assert on
    //   that differs. Killing it needs a src-side message split between the
    //   two guards, which is a behavior change out of scope for coverage-
    //   honesty work.
    "minMsi": 85,
    "mutators": {
        "@default": true
    }
}
